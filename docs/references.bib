@misc{laing2022phonological,
	title = {Phonological Networks and Systematicity in Early Lexical Acquisition},
	url = {https://psyarxiv.com/z8pyg/},
	doi = {10.31234/osf.io/z8pyg},
	abstract = {Infants' early words tend to be phonologically similar. This may reflect a systematic approach to early production, as they adapt newly-acquired forms to fit familiar structures in the output. This 'rich-get-richer' approach to phonological acquisition, known as preferential attachment in network science, assume that new words cluster together with existing phonologically-similar words in the lexicon (or network). This contrasts with recent work (e.g. Fourtassi et al., 2020) showing that the learning environment is the key predictor in learning (i.e. preferential acquisition). However, previous network analyses draw on vocabulary norms, which do not capture individual variability in word learning; here, phonetic transcriptions of nine infants' word productions were analysed from word onset to age 2;6. Network growth models were generated to test whether acquisition was best modelled through preferential attachment or preferential acquisition. Results show that preferential attachment is more convincing, suggesting that infants' early words are systematically acquired according to their phonological properties, such that newly-acquired words are phonologically similar to existing words in the network. Furthermore, infants produce their early words more systematically than we would expect from looking at target forms alone.},
	publisher = {{PsyArXiv}},
	author = {Laing, Catherine E.},
	urldate = {2023-03-09},
	date = {2022-04-08},
	langid = {english},
	keywords = {phonological development, Social and Behavioral Sciences, Developmental Psychology, Language Aquisition, network analysis, network models, {PAT}, preferential acquisition, preferential attachment},
	file = {Full Text PDF:C\:\\Users\\u155880\\Zotero\\storage\\MPMYSY75\\Laing - 2022 - Phonological Networks and Systematicity in Early L.pdf:application/pdf},
}

