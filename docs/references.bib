	keywords = {Bilingualism, language acquisition, language assessment, syntax, vocabulary},
	file = {Full Text PDF:C\:\\Users\\u155880\\Zotero\\storage\\RRG9Z6AB\\Thordardottir et al. - 2006 - Bilingual assessment Can overall proficiency be e.pdf:application/pdf},
}

