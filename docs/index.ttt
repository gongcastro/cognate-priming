\begin{minipage}{\linewidth}
\vspace{.05em}
\emph{ELPD}: sum of expected log pointwise predictive density for a new data set. \emph{SE (ELPD)}: standard error of the \emph{ELPD}, which indictes the uncertainty about the predictive performance for unknown future data. \emph{ELPD (diff)}: pairwise difference in \emph{ELPD} for two models. The difference is computed relative to the model with lowest \emph{ELPD} (best fitting model). \emph{SE ELPD (diff.)}: standard error of component-wise differences of \emph{ELPD} between two models.\\
\end{minipage}

\end{table*}
